# ==============================================================================
# CodeClovers Studio - Environment Configuration Template
# ==============================================================================

# MongoDB Connection String (Local or MongoDB Atlas)
# Default local instance: mongodb://localhost:27017/codeclovers
MONGODB_URI=mongodb://localhost:27017/codeclovers

# Application Port
PORT=3005

# Environment Mode
NODE_ENV=development

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Admin API Access Secret / Token (Optional for protected mutation endpoints)
ADMIN_SECRET_KEY=codeclovers_dev_secret_key_2026
